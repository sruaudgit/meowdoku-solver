<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MeowdokuSolver" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:colorBackground">@color/backdrop</item>
        <item name="android:statusBarColor">@color/backdrop</item>
    </style>

    <style name="Theme.MeowdokuSolver.Transparent">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation</item>
    </style>
</resources>
